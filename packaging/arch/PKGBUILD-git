# Maintainer: Chris Kearney <chris@kearneymail.com>
#
# chonkstep from the branch head. The release PKGBUILD next to this
# file is the pinned-tarball twin; everything below that is not about
# fetching the source is kept identical to it - see its comments for
# how the dependency list was derived.
#
# Build with: makepkg -p PKGBUILD-git

pkgname=chonkstep-git
pkgver=0.2.0.r76.ge1b4e54
pkgrel=1
pkgdesc="A NeXTSTEP-style desktop for Linux: one shell, two real login sessions (X11 window manager and Wayland compositor)"
arch=('x86_64' 'aarch64')
url="https://github.com/iconidentify/chonkstep"
license=('GPL-3.0-only')
depends=(
  'gcc-libs'
  'glibc'
  'libxkbcommon'
  'libglvnd'
  'mesa'
  'libdrm'
  'libinput'
  'seatd'
  'systemd-libs'
  'wayland'
  'xorg-xwayland'
  'foot'
  'dbus'
  'ttf-dejavu'
)
optdepends=(
  'xorg-server: the X11 session (the Wayland session needs no X server)'
  'xorg-xinit: start the X11 session with startx from a TTY'
  'picom: translucent terminals on the X11 session (the compositor composites itself)'
  'wireplumber: wpctl, which the dock sound instrument reads and controls'
  'gsfonts: Nimbus Sans, for the NeXT Lavender theme'
  'ttf-jetbrains-mono-nerd: the terminal typeface the themes configure'
  'noto-fonts: fallback glyph coverage'
  'swaylock: a session locker for lock_command and locked crash recovery'
  'xdg-desktop-portal: portal frontend for screen sharing and portal screenshots'
  'xdg-desktop-portal-wlr: the ScreenCast/Screenshot backend the shipped portal map selects'
  'xdg-desktop-portal-gtk: the fallback portal backend (file chooser and friends)'
  'pipewire: carries screen-share frames from portal backend to application'
  'git: chonk-get install from a git URL'
  'python: dockapps written against the Python binding'
)
makedepends=('rust' 'git')
provides=('chonkstep')
conflicts=('chonkstep')
source=("chonkstep::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd chonkstep
  # <workspace version>.r<commit count>.g<short hash>, so pacman sees a
  # monotonically increasing version between releases.
  printf '%s.r%s.g%s' \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd chonkstep
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd chonkstep
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --workspace
}

check() {
  cd chonkstep
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd chonkstep

  install -Dm755 target/release/chonkstep "$pkgdir/usr/bin/chonkstep"
  install -Dm755 target/release/chonkstep-wayland "$pkgdir/usr/bin/chonkstep-wayland"
  install -Dm755 scripts/chonk-get "$pkgdir/usr/bin/chonk-get"

  install -Dm755 scripts/xsession.sh "$pkgdir/usr/lib/chonkstep/xsession.sh"
  install -Dm755 scripts/wayland-session.sh "$pkgdir/usr/lib/chonkstep/wayland-session.sh"
  install -Dm755 scripts/reload.sh "$pkgdir/usr/lib/chonkstep/reload.sh"
  install -Dm755 scripts/restart.sh "$pkgdir/usr/lib/chonkstep/restart.sh"

  install -d "$pkgdir/usr/share/xsessions" "$pkgdir/usr/share/wayland-sessions"
  cat > "$pkgdir/usr/share/xsessions/chonkstep.desktop" <<'DESKTOP'
[Desktop Entry]
Name=chonkstep
Comment=A NeXTSTEP-style window manager with chiseled chrome
Exec=/usr/lib/chonkstep/xsession.sh
Type=Application
DESKTOP
  cat > "$pkgdir/usr/share/wayland-sessions/chonkstep.desktop" <<'DESKTOP'
[Desktop Entry]
Name=chonkstep (Wayland)
Comment=The chonkstep desktop as a native Wayland compositor
Exec=/usr/lib/chonkstep/wayland-session.sh
DesktopNames=chonkstep
Type=Application
DESKTOP

  install -Dm644 docs/config.example.toml -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/quickstart.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/keybindings.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/instrument-platform.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/dockapp-protocol.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/xwayland-compatibility.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/screen-sharing.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"
}
