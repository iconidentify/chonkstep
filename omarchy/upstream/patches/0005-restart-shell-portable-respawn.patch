 # and a restart plus re-lock is the only way back in without a reboot. So
 # ask the lock service rather than merely pinging the shell: only a locker
 # that reports the lock secure or in progress is worth preserving.
+# omarchy-hyprland-session-locked reads the lock out of Hyprland's
+# solitaryBlockedBy monitor field and exits 2 ("undetermined") where there is
+# no hyprctl to ask. On that answer, fall back to asking the lock service
+# itself: a locker that reports secure or in-progress must not be restarted,
+# which is the case worth catching even without the compositor's help. What
+# the fallback cannot see is the recovery case -- a session still held by the
+# compositor's failsafe behind a locker that has already died -- so `--relock`
+# is offered for it rather than guessed at.
+lock_service_state() {
+  OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell lock status 2>/dev/null |
+    jq -r '.secure or .requested' 2>/dev/null
+}
