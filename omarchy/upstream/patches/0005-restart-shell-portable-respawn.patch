@@ -67,7 +89,31 @@
 
 # Spawn from Hyprland so the shell inherits the canonical session environment,
 # not transient variables from a terminal, SSH connection, or development tool.
-hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null
+#
+# Where there is no Hyprland to dispatch through, the portable stand-in for
+# "the canonical session environment" is the systemd user manager's: a Wayland
+# session publishes WAYLAND_DISPLAY and XDG_CURRENT_DESKTOP there so that
+# D-Bus-activated services (the desktop portals, notably) can find the
+# display. Reconstruct from that and spawn detached.
+#
+# Without this, the dispatch fails, nothing is spawned, the readiness loop
+# below times out, and the script reports failure having already killed the
+# shell in the loop above -- so the one manual recovery for a dead shell is
+# also what leaves you without one.
+respawn_shell() {
+  hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null 2>&1 && return 0
+
+  local key value
+  for key in WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; do
+    value=$(systemctl --user show-environment 2>/dev/null | sed -n "s/^$key=//p" | tail -n 1)
+    [[ -n $value ]] && export "$key=$value"
+  done
+  export OMARCHY_PATH="$session_omarchy_path"
+
+  setsid omarchy-launch-shell </dev/null >/dev/null 2>&1 &
+}
+
+respawn_shell
 
