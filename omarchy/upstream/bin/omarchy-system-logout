#!/bin/bash

# omarchy:summary=Log out after closing application windows
# omarchy:examples=omarchy logout | omarchy system logout
# omarchy:aliases=omarchy logout

# Ending the session.
#
# `uwsm stop` stops an active `wayland-wm@*.service`, which is how a uwsm-
# started session ends and is why it stays first here. A session started some
# other way -- a display manager that Execs a session script, or a bare `exec`
# from a TTY -- has no such unit, and uwsm's answer is not an error: it prints
# "Compositor is not running." and exits 0 (uwsm/main.py, stop_wm). So the old
# unconditional call left the Logout row showing its OSD, closing the windows,
# and never ending the session. logind's `terminate-session` is the portable
# equivalent and needs nothing from the compositor.
#
# `uwsm stop -n` is uwsm's own dry run: it reports "Will stop compositor
# <unit>." when there is a unit to stop and "Compositor is not running."
# when there is not, so it answers exactly the question this branch asks
# without ending anything.
end_session() {
  if command -v uwsm >/dev/null 2>&1 &&
    uwsm stop -n 2>&1 | grep -qE "Will stop compositor|Found running compositor"; then
    uwsm stop
    return
  fi

  if command -v loginctl >/dev/null 2>&1; then
    if [[ -n ${XDG_SESSION_ID:-} ]]; then
      loginctl terminate-session "$XDG_SESSION_ID"
    else
      loginctl terminate-user "$UID"
    fi
    return
  fi

  logger -t omarchy-system-logout "No uwsm session and no loginctl: cannot end the session."
}

# The two-second delay is Omarchy's: the OSD and the window closes below need
# to happen before the session goes. A backgrounded function rather than the
# original `nohup bash -c "sleep 2 && uwsm stop"`, so the fallback chain above
# lives in one place instead of being re-quoted into a string. `trap '' HUP`
# and the redirection are what nohup was doing.
end_session_later() {
  trap '' HUP
  sleep 2
  end_session
}
end_session_later >/dev/null 2>&1 &
disown 2>/dev/null || true

omarchy-osd -i logout -m "Logging out" -d 5000

# Now close all windows
omarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
