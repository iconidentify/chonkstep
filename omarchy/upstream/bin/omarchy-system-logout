#!/bin/bash

# omarchy:summary=Log out after closing application windows
# omarchy:examples=omarchy logout | omarchy system logout
# omarchy:aliases=omarchy logout

# Ending the session.
#
# `uwsm stop` stops an active `wayland-wm@*.service`, which is how a uwsm-
# started session ends and stays first here. A session started some other way
# -- a display manager that Execs a session script, or a bare `exec` from a
# TTY -- has no such unit: uwsm reports "Compositor is not running." and exits
# 0, so the old unconditional call left the Logout row showing its OSD and
# doing nothing at all. logind's `terminate-session` is the portable
# equivalent and needs nothing from the compositor.
end_session() {
  if command -v uwsm >/dev/null 2>&1 &&
    uwsm stop -n 2>&1 | grep -qE "Will stop compositor|Found running compositor"; then
    uwsm stop
    return
  fi

  if command -v loginctl >/dev/null 2>&1; then
    if [[ -n ${XDG_SESSION_ID:-} ]]; then
      loginctl terminate-session "$XDG_SESSION_ID"
    else
      loginctl terminate-user "$UID"
    fi
    return
  fi

  logger -t omarchy-system-logout "No uwsm session and no loginctl: cannot end the session."
}

# Closing the windows first, so applications get their chance to ask about
# unsaved work.
#
# `omarchy-hyprland-window-close-all` is Hyprland IPC and closes nothing
# elsewhere. OMARCHY_TOPLEVEL_HELPER -- the same seam
# omarchy-launch-or-focus uses -- is a program that speaks
# `zwlr_foreign_toplevel_management_v1`, called here as
#
#     "$OMARCHY_TOPLEVEL_HELPER" close-all
#
# `close` in that protocol is the polite close, the same request a taskbar's
# close button sends, so this is not a kill.
close_all_windows() {
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    omarchy-hyprland-window-close-all
    return
  fi

  if [[ -n ${OMARCHY_TOPLEVEL_HELPER:-} ]]; then
    "$OMARCHY_TOPLEVEL_HELPER" close-all >/dev/null 2>&1 || true
    return
  fi

  if command -v wlrctl >/dev/null 2>&1; then
    wlrctl toplevel close >/dev/null 2>&1 || true
  fi
}

# The two-second delay is Omarchy's: the OSD and the window closes below
# need to happen before the session goes. A backgrounded function rather
# than the original `nohup bash -c "sleep 2 && uwsm stop"`, so the fallback
# chain above stays in one place instead of being re-quoted into a string.
end_session_later() {
  sleep 2
  end_session
}
end_session_later >/dev/null 2>&1 &
disown 2>/dev/null || true

omarchy-osd -i logout -m "Logging out" -d 5000

close_all_windows
sleep 1 # Allow apps like Chrome to shutdown correctly
