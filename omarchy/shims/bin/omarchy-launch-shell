#!/bin/bash

# omarchy:summary=Launch the Omarchy shell with its log kept in the journal
# omarchy:hidden=true
#
# chonkstep shim for Omarchy 4.0.x's omarchy-launch-shell.
#
# Omarchy's own launcher is a supervisor: it runs Quickshell, and when
# Quickshell dies of something Qt turned into a bare _exit() (a lost
# Wayland connection raises no signal, so Quickshell's own crash
# handler never fires) it relaunches it. Before relaunching it asks
# whether the compositor is still there, so that a session which is
# tearing down does not burn the attempt budget:
#
#     compositor_alive() { hyprctl -j monitors >/dev/null 2>&1; }
#
# Under any compositor that is not Hyprland, `hyprctl` prints
# "HYPRLAND_INSTANCE_SIGNATURE not set! (is hyprland running?)" and
# exits 1. The supervisor reads that as "the session is going" and
# exits 0 — so a Quickshell that dies is never brought back, and the
# bar, the OSD, the notification daemon, the lock screen and every
# menu the shell draws stay dead until the next login.
#
# This file is Omarchy's launcher with exactly that one function
# replaced. Everything else — systemd-cat for the journal tag,
# QS_DISABLE_FILE_WATCHER, the backgrounded job so the traps fire, the
# clean-exit-means-stop rule, the five-relaunches-in-sixty-seconds
# brake — is theirs, verbatim, so whatever Omarchy changes about the
# rest reaches this shim as a one-line rebase.
#
# The replacement asks the session itself instead of asking Hyprland:
# a Wayland compositor is alive exactly when its socket is there and
# accepts a connection. That is true on Hyprland too, which is why
# omarchy/upstream/ offers the same function as a patch.
#
# Activation and uninstall: docs/omarchy-integration.md.

set -u

# The launcher's one hard requirement, and the one the original takes
# on faith. Said out loud because `set -u` would otherwise report it as
# an unbound variable from inside a function, and because a shim
# started from the wrong environment is the likeliest way to get here.
if [[ -z ${OMARCHY_PATH:-} ]]; then
  echo "omarchy-launch-shell: OMARCHY_PATH is not set (a login shell exports it; /usr/share/omarchy for the package)" >&2
  exit 1
fi

# The socket the session is on. WAYLAND_DISPLAY is normally already
# here (the compositor exports it to everything it spawns); the
# systemd user environment is the fallback for a launcher started from
# outside the session, and is where chonkstep's session script
# publishes the name it allocated (scripts/wayland-session.sh).
if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  WAYLAND_DISPLAY=$(systemctl --user show-environment 2>/dev/null |
    sed -n 's/^WAYLAND_DISPLAY=//p' | tail -n 1)
  [[ -n $WAYLAND_DISPLAY ]] && export WAYLAND_DISPLAY
fi

wayland_socket() {
  local name=${WAYLAND_DISPLAY:-}
  [[ -n $name ]] || return 1
  # An absolute WAYLAND_DISPLAY is a full path; anything else is
  # relative to XDG_RUNTIME_DIR. Both forms are in the spec.
  if [[ $name == /* ]]; then
    printf '%s\n' "$name"
  else
    printf '%s/%s\n' "${XDG_RUNTIME_DIR:-/run/user/$UID}" "$name"
  fi
}

# The portable liveness probe. Two tiers, because they fail
# differently: a socket *file* that has gone away means the compositor
# exited and cleaned up, while a socket that is still there but no
# longer accepts a connection means it died without cleaning up. The
# second tier needs a tool that can connect; socat is already an
# Omarchy dependency (omarchy-launch-screensaver uses it), and when it
# is missing the file test alone is still strictly better than asking
# a compositor that is not running.
#
# Retried, for the same reason Omarchy retries: a compositor busy
# reconfiguring outputs can be slow to answer without being gone, and
# that is exactly when the shell dies.
compositor_alive() {
  local socket attempt
  socket=$(wayland_socket) || return 1

  for attempt in 1 2 3; do
    if [[ -S $socket ]]; then
      if ! command -v socat >/dev/null 2>&1; then
        return 0
      fi
      # -u and /dev/null: connect, write nothing, hang up. A
      # compositor answers the connect; a dead socket file does not.
      if socat -u /dev/null "UNIX-CONNECT:$socket" >/dev/null 2>&1; then
        return 0
      fi
    fi
    ((attempt < 3)) && sleep 0.5
  done

  return 1
}

# ---------------------------------------------------------------------
# Everything below is Omarchy 4.0.x's omarchy-launch-shell unchanged.

run_shell() {
  QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
    systemd-cat -t omarchy-shell -- quickshell -n -p "$OMARCHY_PATH/shell" &
  shell_pid=$!

  local status
  while true; do
    wait "$shell_pid"
    status=$?

    # An interrupted wait and a shell killed by that signal report alike.
    kill -0 "$shell_pid" 2>/dev/null || break
  done

  shell_pid=""
  return $status
}

terminating=0
shell_pid=""

stop() {
  terminating=1
  [[ -n $shell_pid ]] && kill -TERM "$shell_pid" 2>/dev/null
  return 0
}
trap stop HUP INT TERM

attempts=0
window_started=$SECONDS

while true; do
  # A signal during the backoff only reaches the trap once the sleep is over.
  ((terminating)) && exit 0

  run_shell
  status=$?

  ((terminating)) && exit 0
  ((status == 0)) && exit 0

  # Relaunching into a session already tearing down burns the attempt budget.
  compositor_alive || exit 0

  if ((SECONDS - window_started > 60)); then
    attempts=0
    window_started=$SECONDS
  fi

  if ((++attempts > 5)); then
    logger -t omarchy-shell "Giving up on the Omarchy shell after $attempts relaunches in under a minute."
    exit 1
  fi

  logger -t omarchy-shell "Omarchy shell exited with status $status; relaunching."
  sleep 1
done
