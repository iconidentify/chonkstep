#!/bin/bash

# omarchy:summary=Restart the Omarchy shell
# omarchy:examples=omarchy restart shell
#
# chonkstep shim for Omarchy 4.0.x's omarchy-restart-shell.
#
# Omarchy's version does four Hyprland-specific things, of which one
# is fatal off Hyprland:
#
#   1. derives HYPRLAND_INSTANCE_SIGNATURE from $XDG_RUNTIME_DIR/hypr/
#      so it can be run over ssh — harmless when that directory does
#      not exist;
#   2. asks `omarchy-hyprland-session-locked`, which reads a lock out
#      of `hyprctl -j monitors`' solitaryBlockedBy field. Off Hyprland
#      that exits 2 ("undetermined") and the caller treats it as
#      unlocked;
#   3. `quickshell kill -p "$CONFIG_DIR" --any-display` — portable,
#      works here;
#   4. **`hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")'`**
#      to respawn. This is the fatal one. It fails, nothing is
#      spawned, the 20 × 0.1s ping loop times out, and the script
#      reports "Omarchy shell did not become ready after restart" and
#      exits 1 — having already killed the shell in step 3.
#
# So on chonkstep the first-party restart is strictly destructive:
# it is the *manual recovery* for a dead shell, and it is what leaves
# you without one.
#
# The two replacements here:
#
#   - Lock state comes from the lock service itself
#     (`omarchy-shell lock status`) rather than from the compositor's
#     monitor list. That is the question actually being asked, it
#     needs no compositor-specific field, and it is strictly more
#     accurate: Omarchy's own comment notes the hyprctl route reports
#     a lock whose client has already died.
#   - Respawn is `setsid` from an environment reconstructed out of the
#     systemd user manager, which is the portable stand-in for
#     Omarchy's "spawn from Hyprland so the shell inherits the
#     canonical session environment". chonkstep's session script
#     publishes WAYLAND_DISPLAY, XDG_CURRENT_DESKTOP and
#     XDG_SESSION_TYPE there for exactly this class of consumer (it is
#     what makes the desktop portals work); OMARCHY_PATH comes from
#     the login shell as everywhere else in Omarchy.
#
# What is deliberately NOT reproduced, and why: Omarchy's automatic
# **relock**. Its recovery case is real on chonkstep too — chonkstep's
# ext-session-lock keeps the session blanked when a locker dies (see
# crates/wm-wayland/src/lock.rs), and Omarchy's Quickshell is the
# locker when the lock came from `omarchy-system-lock` — but the
# *detection* is not portable: Omarchy reads the lock out of Hyprland's
# `solitaryBlockedBy` monitor field, and chonkstep publishes no
# equivalent. Rather than guess, this exposes it as a flag:
#
#     omarchy-restart-shell --relock
#
# restarts the shell and then holds the session locked until the user
# authenticates, which is the way back in from "the shell died while
# the screen was locked" without a reboot. That whole branch is
# Omarchy's `relock_session`, unchanged.
#
# Activation and uninstall: docs/omarchy-integration.md.

set -u

relock=0
case ${1:-} in
"") ;;
--relock) relock=1 ;;
*)
  echo "usage: omarchy-restart-shell [--relock]" >&2
  exit 1
  ;;
esac

# A caller opened after dev link/unlink may disagree with the still-running
# desktop. The user manager receives the session's environment at start.
session_omarchy_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n 1)
: "${session_omarchy_path:=${OMARCHY_PATH:-}}"

CONFIG_DIR="$session_omarchy_path/shell"
[[ -f $CONFIG_DIR/shell.qml ]] || {
  echo "Omarchy shell config not found: $CONFIG_DIR" >&2
  exit 1
}

shell_ipc() {
  OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell "$@"
}

# Ask the locker, not the compositor. `lock status` answers `secure`
# (the lock is up and holding the screen) or `requested` (it is coming
# up); either means a restart would kill the lock client and strand
# the session behind the compositor's failsafe. Anything else — idle,
# no lock plugin, no shell to ask — is not a lock worth preserving.
locking=$(shell_ipc lock status 2>/dev/null | jq -r '.secure or .requested' 2>/dev/null)
if [[ $locking == "true" ]]; then
  echo "Refusing to restart Omarchy shell while the session is locked." >&2
  exit 1
fi

# Each kill stops the oldest matching instance and only returns once it has
# fully exited, so the no-duplicate launch below can't race a dying shell.
while timeout 5 quickshell kill -p "$CONFIG_DIR" --any-display >/dev/null 2>&1; do :; done

# The environment the replacement needs, taken from the session rather
# than from this terminal. Only variables the user manager actually
# carries are exported, so a missing one stays missing rather than
# becoming an empty string the shell would believe.
for key in WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; do
  value=$(systemctl --user show-environment 2>/dev/null | sed -n "s/^$key=//p" | tail -n 1)
  [[ -n $value ]] && export "$key=$value"
done
export OMARCHY_PATH="$session_omarchy_path"

# `setsid` and a detached stdio, so the new supervisor outlives this
# script (and outlives the terminal, or the menu action's `bash -lc`,
# that ran it). The launcher on PATH is preferred over the one under
# the Omarchy root, because a machine with this shim installed has the
# portable supervisor first on PATH and that is the one that will
# actually relaunch a crashed shell.
launcher=$(command -v omarchy-launch-shell || printf '%s\n' "$session_omarchy_path/bin/omarchy-launch-shell")
setsid "$launcher" </dev/null >/dev/null 2>&1 &

# Omarchy's relock_session, verbatim but for the IPC helper: the lock
# plugin loads asynchronously, so a fresh shell answers ping before it
# can lock and may refuse an early lock request outright. Request and
# poll until the session reports secure, re-requesting as needed, so
# recovery never claims success while the failsafe is still up.
relock_session() {
  local state deadline=$((SECONDS + 30))

  while ((SECONDS < deadline)); do
    state=$(shell_ipc lock status 2>/dev/null |
      jq -r 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' 2>/dev/null)

    case $state in
    secure) return 0 ;;
    locking) ;;
    *) shell_ipc lock lock >/dev/null 2>&1 ;;
    esac

    sleep 0.1
  done

  return 1
}

for ((attempt = 0; attempt < 20; attempt++)); do
  if shell_ipc shell ping >/dev/null 2>&1; then
    if ((relock)) && ! relock_session; then
      echo "Omarchy shell restarted, but the session lock was not re-secured." >&2
      exit 1
    fi
    # Invitation toasts (like Voxtype/fingerprint setup) die with the old
    # shell, and their notify-send waiters hang forever: the dying server
    # never emits NotificationClosed. A still-running omarchy-*-invitation
    # unit is therefore an unanswered invitation — re-run it so its toast
    # reappears on the new shell.
    systemctl --user try-restart 'omarchy-*-invitation.service' 2>/dev/null || true
    exit 0
  fi
  sleep 0.1
done

echo "Omarchy shell did not become ready after restart." >&2
exit 1
