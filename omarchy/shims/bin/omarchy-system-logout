#!/bin/bash

# omarchy:summary=Log out after closing application windows
# omarchy:examples=omarchy logout | omarchy system logout
# omarchy:aliases=omarchy logout
#
# chonkstep shim for Omarchy 4.0.x's omarchy-system-logout.
#
# Omarchy's version is three statements:
#
#     nohup bash -c "sleep 2 && uwsm stop" &
#     omarchy-osd -i logout -m "Logging out" -d 5000
#     omarchy-hyprland-window-close-all      # hyprctl clients + dispatch close
#
# Only the first of those is a problem here, and it is not a compositor
# problem at all. `uwsm stop` looks for an active `wayland-wm@*.service`
# on the session bus. chonkstep is started by the display manager (or
# from a TTY) through its own session script, not by uwsm, so there is
# no such unit: uwsm prints "Compositor is not running." and **exits
# 0**. Verified on this machine with `uwsm stop -n`. The Logout row
# therefore shows an OSD reading "Logging out" for five seconds and
# leaves you logged in.
#
# The window-closing statement needs no help. `omarchy-hyprland-window-
# close-all` is `hyprctl clients -j` piped into `hyprctl dispatch`, and
# chonkstep answers Hyprland's IPC (docs/hyprland-ipc.md), so it closes
# the windows here exactly as it does on Hyprland. An earlier version
# of this shim closed them over wlr-foreign-toplevel with
# `chonk-toplevel`; that is no longer needed and has been removed, so
# this file now has no chonkstep-specific dependency of any kind.
#
# What replaces `uwsm stop` is logind: `loginctl terminate-session`.
# That is the portable "log this session out" primitive, it is what
# ends a session started by any display manager or from a TTY, and it
# needs nothing from the compositor. `uwsm stop` is kept as a fast path
# for a session that really is uwsm-managed, so this file is also
# correct on Hyprland. It is byte-for-byte the same logic as the
# upstream patch in ../upstream/ — the only reason it exists separately
# is that /usr/bin/omarchy-system-logout is not ours to edit.
#
# One honest wart, stated here rather than papered over, because it is
# visible the *next* time you log in: chonkstep's session script
# (scripts/wayland-session.sh) reads any abnormal compositor exit as a
# crash and drops a `recovery` marker in $XDG_STATE_HOME/chonkstep.
# logind's SIGTERM is an abnormal exit by that definition, so a logout
# through this shim leaves the marker behind and the next session
# announces itself as recovered — and comes back locked, if
# `lock_command` is set. chonkstep's own root-menu Exit does not do
# this, because it exits 0.
#
# There is no reliable way for this script to clean up after itself:
# anything it leaves running to remove the marker later is inside the
# session scope logind is tearing down, and dies with it. The fix is
# compositor-side and small — a `quit` marker beside the existing
# `restart` and `reload` ones, or a SIGTERM handler that ends the
# session with status 0 — and until it lands, the root menu's own Exit
# remains the cleaner way out. Use this shim for the case it is for:
# Omarchy's Logout row, which today does nothing whatsoever.
#
# Activation and uninstall: docs/omarchy-integration.md.

# Ending the session, least to most brutal. Each tier is tried only
# when the one before it does not apply.
end_session() {
  # A genuinely uwsm-managed session: its own stop is the graceful one,
  # and it is what Omarchy means. Asked with `-n` (uwsm's dry run)
  # first, so this branch is taken only when there is really a unit to
  # stop — `Will stop compositor <unit>.` when there is, `Compositor is
  # not running.` when there is not.
  if command -v uwsm >/dev/null 2>&1 &&
    uwsm stop -n 2>&1 | grep -qE "Will stop compositor|Found running compositor"; then
    uwsm stop
    return
  fi

  # The portable route. logind terminates every process in the
  # session's scope, which is precisely "log out" for a session started
  # by a display manager or from a TTY.
  if command -v loginctl >/dev/null 2>&1; then
    if [[ -n ${XDG_SESSION_ID:-} ]]; then
      loginctl terminate-session "$XDG_SESSION_ID"
    else
      loginctl terminate-user "$UID"
    fi
    return
  fi

  logger -t omarchy-system-logout "No uwsm session and no loginctl: cannot end the session."
}

# The two-second delay is Omarchy's: the OSD and the window closes below
# need to happen before the session goes. A backgrounded function rather
# than the original `nohup bash -c "sleep 2 && uwsm stop"`, so the
# fallback chain above lives in one place instead of being re-quoted
# into a string. `trap '' HUP` and the redirection are what nohup did.
end_session_later() {
  trap '' HUP
  sleep 2
  end_session
}
end_session_later >/dev/null 2>&1 &
disown 2>/dev/null || true

omarchy-osd -i logout -m "Logging out" -d 5000

# Now close all windows
omarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
