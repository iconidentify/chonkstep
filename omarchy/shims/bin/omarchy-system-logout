#!/bin/bash

# omarchy:summary=Log out after closing application windows
# omarchy:examples=omarchy logout | omarchy system logout
# omarchy:aliases=omarchy logout
#
# chonkstep shim for Omarchy 4.0.x's omarchy-system-logout.
#
# Omarchy's version is three statements:
#
#     nohup bash -c "sleep 2 && uwsm stop" &
#     omarchy-osd -i logout -m "Logging out" -d 5000
#     omarchy-hyprland-window-close-all      # hyprctl clients + dispatch close
#
# Both ends of it are Hyprland-shaped, and the failure is quiet rather
# than loud, which is worse:
#
#   - `uwsm stop` looks for an active `wayland-wm@*.service` on the
#     session bus. chonkstep is started by the display manager (or from
#     a TTY) through its own session script, not by uwsm, so there is no
#     such unit: uwsm prints "Compositor is not running." and **exits
#     0**. Verified on this machine with `uwsm stop -n`.
#   - `omarchy-hyprland-window-close-all` pipes `hyprctl clients -j`
#     into `hyprctl dispatch`, so it closes nothing.
#
# The net effect on chonkstep is that the Logout row shows an OSD
# reading "Logging out" for five seconds and then does nothing at all:
# no windows closed, no session ended.
#
# This shim keeps the shape and replaces both ends:
#
#   - Windows close over `wlr-foreign-toplevel-management`, through
#     `chonk-toplevel close-all` (crates/chonk-toplevel). That is a
#     polite close — the same request a taskbar's close button sends —
#     so an application with unsaved work still gets to ask.
#   - The session ends through logind: `loginctl terminate-session`.
#     That is the portable "log this session out" primitive, it is what
#     ends a session started by any display manager or from a TTY, and
#     it needs nothing from the compositor. `uwsm stop` is kept as a
#     fast path for a session that really is uwsm-managed, so this file
#     is also correct on Hyprland.
#
# One honest wart, stated here rather than papered over, because it is
# visible the *next* time you log in: chonkstep's session script
# (scripts/wayland-session.sh) reads any abnormal compositor exit as a
# crash and drops a `recovery` marker in $XDG_STATE_HOME/chonkstep.
# logind's SIGTERM is an abnormal exit by that definition, so a logout
# through this shim leaves the marker behind and the next session
# announces itself as recovered — and comes back locked, if
# `lock_command` is set. chonkstep's own root-menu Exit does not do
# this, because it exits 0.
#
# There is no reliable way for this script to clean up after itself:
# anything it leaves running to remove the marker later is inside the
# session scope logind is tearing down, and dies with it. The fix is
# compositor-side and small — a `quit` marker beside the existing
# `restart` and `reload` ones, or a SIGTERM handler that ends the
# session with status 0 — and until it lands, the root menu's own Exit
# remains the cleaner way out. Use this shim for the case it is for:
# Omarchy's Logout row, which today does nothing whatsoever.
#
# Activation and uninstall: docs/omarchy-integration.md.

set -u

# The client that can close windows without hyprctl, resolved the same
# way the launch-or-focus shim resolves it.
find_client() {
  local candidate here
  if [[ -n ${CHONK_TOPLEVEL:-} ]]; then
    printf '%s\n' "$CHONK_TOPLEVEL"
    return 0
  fi
  if candidate=$(command -v chonk-toplevel 2>/dev/null); then
    printf '%s\n' "$candidate"
    return 0
  fi
  here=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../../.." && pwd) || return 1
  for candidate in "$here/target/release/chonk-toplevel" "$here/target/debug/chonk-toplevel"; do
    [[ -x $candidate ]] && printf '%s\n' "$candidate" && return 0
  done
  return 1
}

# Ending the session, in the order of least to most brutal. Each tier
# is tried only when the one before it does not apply.
end_session() {
  # A genuinely uwsm-managed session: its own stop is the graceful one,
  # and it is what Omarchy means. Asked with `-n` (dry run) first so
  # this branch is taken only when there is really a unit to stop.
  if command -v uwsm >/dev/null 2>&1 &&
    uwsm stop -n 2>&1 | grep -qE "Will stop compositor|Found running compositor"; then
    uwsm stop
    return 0
  fi

  # The portable route. logind terminates every process in the
  # session's scope, which is precisely "log out" for a session started
  # by a display manager or from a TTY.
  if command -v loginctl >/dev/null 2>&1; then
    local session=${XDG_SESSION_ID:-}
    if [[ -z $session ]]; then
      session=$(loginctl show-user "$UID" --property=Display --value 2>/dev/null)
    fi
    if [[ -n $session ]]; then
      loginctl terminate-session "$session"
      return 0
    fi
    # No session id to name: terminate whatever this user has.
    loginctl terminate-user "$UID"
    return 0
  fi

  echo "omarchy-system-logout: no uwsm session and no loginctl; cannot end the session" >&2
  return 1
}

# Omarchy's own ordering: announce, then close, then go. The OSD is the
# shell's, and works here unchanged.
omarchy-osd -i logout -m "Logging out" -d 5000 2>/dev/null || true

if CLIENT=$(find_client); then
  closed=$("$CLIENT" close-all 2>/dev/null) || closed=""
  [[ -n $closed ]] && echo "omarchy-system-logout: asked $closed window(s) to close"
else
  echo "omarchy-system-logout: chonk-toplevel not found; logging out without closing windows first" >&2
fi

# Allow apps like Chrome to shut down correctly.
sleep 1

end_session
